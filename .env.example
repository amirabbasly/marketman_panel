# کپی شود به .env — اسکریپت deploy.sh این کار را خودکار انجام می‌دهد
# پورت‌های هاست (فقط روی 127.0.0.1) — اگر روی سرور اشغال بودند، همین‌ها را عوض کنید
# و پورت‌های proxy_pass در nginx/marketman.conf را هم به همان مقدار تغییر دهید
FRONTEND_PORT=3001
BACKEND_PORT=5100
DB_PORT=5433
POSTGRES_USER=marketman
POSTGRES_PASSWORD=marketmanpass_قوی_انتخاب_کنید
POSTGRES_DB=marketman
DATABASE_URL=postgresql://marketman:marketmanpass@db:5432/marketman
JWT_SECRET=openssl-rand-hex-32-اینجا
PORT=5000
CORS_ORIGIN=*
NEXT_PUBLIC_API_URL=/api
ADMIN_EMAIL=admin@marketman.ir
ADMIN_PASSWORD=admin123456
